<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="POSscan.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1D2433"/>
    <SolidColorBrush x:Key="Muted" Color="#5D6778"/>
    <SolidColorBrush x:Key="Hairline" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="Canvas" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHover" Color="#115EA3"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EBF3FC"/>
    <SolidColorBrush x:Key="Warn" Color="#8A4B00"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF4DC"/>
    <SolidColorBrush x:Key="Good" Color="#0B6B3A"/>
    <SolidColorBrush x:Key="GoodSoft" Color="#E3F6EA"/>
    <SolidColorBrush x:Key="Bad" Color="#A4262C"/>
    <SolidColorBrush x:Key="BadSoft" Color="#FDECEC"/>
    <!-- Keep Fluent's own accent in step, for focus rings and selection. -->
    <Color x:Key="SystemAccentColor">#0F6CBD</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window, UserControl">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C5CBD4"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#AEB6C2"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#D5D9E0"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EBF3FC"/>
      <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
    </Style>
    <Style Selector="Button.fix">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
  </Application.Styles>
</Application>
