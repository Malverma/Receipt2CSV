<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>POSscan</AssemblyName>
    <RootNamespace>POSscan.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>POSscan</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\posscan.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\posscan.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\POSscan.Core\POSscan.Core.csproj" />
    <ProjectReference Include="..\POSscan.Data\POSscan.Data.csproj" />
    <ProjectReference Include="..\POSscan.Ocr\POSscan.Ocr.csproj" />
  </ItemGroup>

</Project>
